<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GestionTareas.Views.NuevaTareaPage"
    BackgroundColor="{StaticResource Background}"
    Title="Nueva tarea"
    NavigationPage.HasBackButton="True"
    Loaded="OnPageLoaded">

    <Grid
        RowDefinitions="*,Auto">

        <!-- CONTENIDO -->

        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                Padding="24,28,24,20"
                Spacing="25">
                
                <!-- ENCABEZADO -->


                <VerticalStackLayout
                    x:Name="HeaderSection"
                    Spacing="5"
                    Opacity="0">

                    <Label
                        Text="{Binding EtiquetaFormulario}"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Accent}"
                        CharacterSpacing="2" />

                    <Label
                        Text="{Binding TituloFormulario}"
                        Style="{StaticResource TitleLabel}"
                        FontSize="30" />

                    <Label
                        Text="Define el título, descripción y prioridad."
                        Style="{StaticResource SubtitleLabel}" />

                </VerticalStackLayout>

                <!-- TÍTULO Y DESCRIPCIÓN -->

                <VerticalStackLayout
                    x:Name="TitleSection"
                    Spacing="8"
                    Opacity="0">

                    <Label
                        Text="Título"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="¿Qué necesitas hacer?"
                        Style="{StaticResource TaskEntry}"
                        ClearButtonVisibility="WhileEditing"
                        Text="{Binding NuevoTitulo}" />


                    <Label
                        Text="Descripción"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        Margin="0,10,0,0" />

                    <Editor
                        Placeholder="Añade una descripción..."
                        Text="{Binding NuevaDescripcion}"
                        TextColor="{StaticResource TextPrimary}"
                        PlaceholderColor="{StaticResource TextMuted}"
                        BackgroundColor="{StaticResource Surface}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="90"
                        MaximumHeightRequest="140"
                        Margin="0,2,0,0" />

                    <Label
                        Text="Añade información adicional sobre esta tarea."
                        FontSize="12"
                        TextColor="{StaticResource TextMuted}" />

                </VerticalStackLayout>

                <!-- PRIORIDAD -->

                <VerticalStackLayout
                    x:Name="PrioritySection"
                    Spacing="10"
                    Opacity="0">

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Prioridad"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Selecciona qué tan importante es esta tarea."
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8">


                        <!-- BAJA -->

                        <Border
                            x:Name="BajaCard"
                            Grid.Column="0"
                            Padding="12,14"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            BackgroundColor="{Binding EsPrioridadBaja, Converter={StaticResource BoolToColorConverter}}">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="10" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnBajaTapped" />

                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="10">

                                <BoxView
                                    HeightRequest="5"
                                    BackgroundColor="{StaticResource PriorityLow}"
                                    CornerRadius="3" />

                                <Label
                                    Text="BAJA"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Menor"
                                    FontSize="11"
                                    TextColor="{StaticResource TextMuted}"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                        </Border>


                        <!-- MEDIA -->

                        <Border
                            x:Name="MediaCard"
                            Grid.Column="1"
                            Padding="12,14"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            BackgroundColor="{Binding EsPrioridadMedia, Converter={StaticResource BoolToColorConverter}}">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="10" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnMediaTapped" />

                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="10">

                                <BoxView
                                    HeightRequest="5"
                                    BackgroundColor="{StaticResource PriorityMedium}"
                                    CornerRadius="3" />

                                <Label
                                    Text="MEDIA"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Normal"
                                    FontSize="11"
                                    TextColor="{StaticResource TextMuted}"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                        </Border>


                        <!-- ALTA -->

                        <Border
                            x:Name="AltaCard"
                            Grid.Column="2"
                            Padding="12,14"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            BackgroundColor="{Binding EsPrioridadAlta, Converter={StaticResource BoolToColorConverter}}">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="10" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnAltaTapped" />

                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="10">

                                <BoxView
                                    HeightRequest="5"
                                    BackgroundColor="{StaticResource PriorityHigh}"
                                    CornerRadius="3" />

                                <Label
                                    Text="ALTA"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Urgente"
                                    FontSize="11"
                                    TextColor="{StaticResource TextMuted}"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- VISTA PREVIA -->

                <VerticalStackLayout
                    x:Name="PreviewSection"
                    Spacing="10"
                    Opacity="0">

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Vista previa"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Así aparecerá tu tarea en la lista."
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Border
                        x:Name="PreviewCard"
                        Style="{StaticResource CardBorder}"
                        Padding="16">

                        <Grid
                            ColumnDefinitions="5,*,Auto"
                            ColumnSpacing="14">


                            <!-- INDICADOR -->

                            <BoxView
                                Grid.Column="0"
                                BackgroundColor="{Binding NuevaPrioridad, Converter={StaticResource PrioridadColorConverter}}"
                                CornerRadius="2"
                                VerticalOptions="Fill" />


                            <!-- INFORMACIÓN -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding NuevoTitulo}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding NuevaDescripcion}"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                                <Label
                                    Text="Pendiente"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />

                            </VerticalStackLayout>


                            <!-- PRIORIDAD -->

                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="PRIORIDAD"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextMuted}"
                                    HorizontalOptions="End" />

                                <Label
                                    Text="{Binding NuevaPrioridad}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding NuevaPrioridad, Converter={StaticResource PrioridadColorConverter}}"
                                    HorizontalOptions="End" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- BOTÓN -->

        <Border
            Grid.Row="1"
            Background="{StaticResource Background}"
            Padding="24,10,24,15">

            <Button
                x:Name="CreateButton"
                Text="{Binding TextoBotonFormulario}"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnCrearTareaClicked"
                Opacity="0" />

        </Border>

    </Grid>

</ContentPage>