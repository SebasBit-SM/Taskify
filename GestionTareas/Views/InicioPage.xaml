<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GestionTareas.Views.InicioPage"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasBackButton="False"
    Loaded="OnPageLoaded">

    <Grid RowDefinitions="*,Auto">

        <!-- CONTENIDO -->

        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                Padding="24,30,24,20"
                Spacing="24">

                <!-- ENCABEZADO -->

                <VerticalStackLayout
                    x:Name="HeaderSection"
                    Spacing="6"
                    Opacity="0">

                    <Label
                        Text="TASKIFY"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Accent}"
                        CharacterSpacing="2" />

                    <Label
                        Text="Hola, Admin"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Label
                        Text="Aquí tienes un resumen de tus tareas."
                        Style="{StaticResource SubtitleLabel}" />

                </VerticalStackLayout>

                <!-- RESUMEN -->

                <Border
                    x:Name="SummaryCard"
                    Style="{StaticResource CardBorder}"
                    Background="{StaticResource Surface}"
                    Padding="20"
                    Opacity="0">

                    <VerticalStackLayout
                        Spacing="18">

                        <Label
                            Text="RESUMEN"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextMuted}"
                            CharacterSpacing="1.5" />

                        <Grid
                            ColumnDefinitions="*,Auto,*">

                            <!-- PENDIENTES -->

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="{Binding TareasPendientes}"
                                    FontSize="34"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Accent}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Pendientes"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>


                            <!-- SEPARADOR -->

                            <BoxView
                                Grid.Column="1"
                                WidthRequest="1"
                                HeightRequest="45"
                                BackgroundColor="{StaticResource BorderColor}"
                                VerticalOptions="Center" />


                            <!-- COMPLETADAS -->

                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3">

                                <Label
                                    Text="{Binding TareasCompletadas}"
                                    FontSize="34"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Success}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Completadas"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- TAREAS RECIENTES -->

                <Grid
                    x:Name="RecentHeader"
                    ColumnDefinitions="*,Auto"
                    Margin="0,4,0,0"
                    Opacity="0">

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Tareas recientes"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Tus últimas actividades"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="Ver todas"
                        TextColor="{StaticResource Accent}"
                        BackgroundColor="Transparent"
                        FontSize="13"
                        FontAttributes="Bold"
                        Padding="5"
                        Clicked="OnVerTodasClicked"
                        VerticalOptions="Center" />

                </Grid>

                <!-- LISTA -->

                <CollectionView
                    x:Name="RecentTasks"
                    ItemsSource="{Binding TareasRecientes}"
                    SelectionMode="None"
                    HeightRequest="225">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Style="{StaticResource CardBorder}"
                                Margin="0,0,0,10"
                                Padding="14">

                                <Grid
                                    ColumnDefinitions="5,*,Auto"
                                    ColumnSpacing="14">

                                    <!-- INDICADOR -->

                                    <BoxView
                                        Grid.Column="0"
                                        WidthRequest="5"
                                        HeightRequest="52"
                                        BackgroundColor="{Binding PrioridadColor}"
                                        CornerRadius="2"
                                        VerticalOptions="Center" />


                                    <!-- INFORMACIÓN -->

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Titulo}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding EstadoTexto}"
                                            FontSize="13"
                                            TextColor="{StaticResource TextSecondary}" />

                                    </VerticalStackLayout>


                                    <!-- PRIORIDAD -->

                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        Spacing="2"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="{Binding PrioridadIcono}"
                                            FontSize="12"
                                            TextColor="{Binding PrioridadColor}"
                                            HorizontalOptions="Center" />

                                        <Label
                                            Text="{Binding Prioridad}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{Binding PrioridadColor}"
                                            HorizontalOptions="Center" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                    <!-- SIN TAREAS -->

                    <CollectionView.EmptyView>

                        <Border
                            Style="{StaticResource CardBorder}"
                            Padding="22">

                            <VerticalStackLayout
                                Spacing="7"
                                HorizontalOptions="Center">

                                <Label
                                    Text="Sin tareas"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Crea tu primera tarea para comenzar."
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalTextAlignment="Center"
                                    HorizontalOptions="Center" />

                            </VerticalStackLayout>

                        </Border>

                    </CollectionView.EmptyView>

                </CollectionView>
                
                <!-- NUEVA TAREA -->

                <Button
                    x:Name="NewTaskButton"
                    Text="+  Nueva tarea"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,5"
                    Clicked="OnNuevaTareaClicked"
                    Opacity="0" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- NAVEGACIÓN -->

        <Border
            Grid.Row="1"
            Background="{StaticResource Surface}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1"
            Padding="8,9">

            <Grid
                ColumnDefinitions="*,*,*">

                <!-- INICIO -->

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="INICIO"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Accent}"
                        HorizontalOptions="Center" />

                    <BoxView
                        WidthRequest="22"
                        HeightRequest="2"
                        BackgroundColor="{StaticResource Accent}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>


                <!-- TAREAS -->

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnTareasTapped" />

                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="TAREAS"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextMuted}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>


                <!-- AJUSTES -->

                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="2">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnAjustesTapped" />

                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="AJUSTES"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextMuted}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>