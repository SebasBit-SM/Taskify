<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================= -->
    <!-- TASKIFY - INDIGO GOLD -->
    <!-- ========================= -->

    <!-- Marca -->

    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#4338CA</Color>
    <Color x:Key="PrimaryLight">#EDE9FE</Color>


    <!-- Acento dorado -->

    <Color x:Key="Accent">#F5B83D</Color>
    <Color x:Key="AccentDark">#D99618</Color>
    <Color x:Key="AccentLight">#FFF1C7</Color>


    <!-- ========================= -->
    <!-- FONDOS -->
    <!-- ========================= -->

    <Color x:Key="Background">#0F172A</Color>

    <Color x:Key="Surface">#1E293B</Color>

    <Color x:Key="SurfaceAlt">#25334A</Color>

    <Color x:Key="BorderColor">#334155</Color>


    <!-- ========================= -->
    <!-- TEXTOS -->
    <!-- ========================= -->

    <Color x:Key="TextPrimary">#F8FAFC</Color>

    <Color x:Key="TextSecondary">#CBD5E1</Color>

    <Color x:Key="TextMuted">#94A3B8</Color>


    <!-- ========================= -->
    <!-- ESTADOS -->
    <!-- ========================= -->

    <Color x:Key="Success">#22C55E</Color>

    <Color x:Key="Warning">#F59E0B</Color>

    <Color x:Key="Danger">#EF4444</Color>

    <!-- Fondo para mensajes de error -->
    <Color x:Key="DangerLight">#FDECEC</Color>

    <!-- ========================= -->
    <!-- PRIORIDADES -->
    <!-- ========================= -->

    <Color x:Key="PriorityLow">#4DBB91</Color>

    <Color x:Key="PriorityMedium">#F5B83D</Color>

    <Color x:Key="PriorityHigh">#F06A6A</Color>


    <!-- ========================= -->
    <!-- ELEMENTOS ESPECIALES -->
    <!-- ========================= -->

    <Color x:Key="InputBackground">#182337</Color>

    <Color x:Key="InputBorder">#3A4A63</Color>

    <Color x:Key="SelectedBackground">#2B315D</Color>

</ResourceDictionary>