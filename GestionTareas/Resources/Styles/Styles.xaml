<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <!-- ========================= -->
    <!-- TÍTULOS -->
    <!-- ========================= -->

    <Style
        x:Key="TitleLabel"
        TargetType="Label">

        <Setter
            Property="TextColor"
            Value="{StaticResource TextPrimary}" />

        <Setter
            Property="FontSize"
            Value="28" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

    </Style>


    <!-- ========================= -->
    <!-- SUBTÍTULOS -->
    <!-- ========================= -->

    <Style
        x:Key="SubtitleLabel"
        TargetType="Label">

        <Setter
            Property="TextColor"
            Value="{StaticResource TextSecondary}" />

        <Setter
            Property="FontSize"
            Value="15" />

    </Style>


    <!-- ========================= -->
    <!-- BOTÓN PRINCIPAL -->
    <!-- ========================= -->

    <Style
        x:Key="PrimaryButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource Accent}" />

        <Setter
            Property="TextColor"
            Value="#111827" />

        <Setter
            Property="CornerRadius"
            Value="8" />

        <Setter
            Property="HeightRequest"
            Value="52" />

        <Setter
            Property="FontSize"
            Value="16" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

        <Setter
            Property="Padding"
            Value="16,0" />

    </Style>


    <!-- ========================= -->
    <!-- BOTÓN SECUNDARIO -->
    <!-- ========================= -->

    <Style
        x:Key="SecondaryButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="Transparent" />

        <Setter
            Property="TextColor"
            Value="{StaticResource TextPrimary}" />

        <Setter
            Property="BorderColor"
            Value="{StaticResource BorderColor}" />

        <Setter
            Property="BorderWidth"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="8" />

        <Setter
            Property="HeightRequest"
            Value="50" />

        <Setter
            Property="FontSize"
            Value="15" />

    </Style>


    <!-- ========================= -->
    <!-- BOTÓN DE TEXTO -->
    <!-- ========================= -->

    <Style
        x:Key="TextButton"
        TargetType="Button">

        <Setter
            Property="BackgroundColor"
            Value="Transparent" />

        <Setter
            Property="TextColor"
            Value="{StaticResource Accent}" />

        <Setter
            Property="FontSize"
            Value="13" />

        <Setter
            Property="Padding"
            Value="8,0" />

    </Style>


    <!-- ========================= -->
    <!-- ENTRY -->
    <!-- ========================= -->

    <Style
        x:Key="TaskEntry"
        TargetType="Entry">

        <Setter
            Property="TextColor"
            Value="{StaticResource TextPrimary}" />

        <Setter
            Property="PlaceholderColor"
            Value="{StaticResource TextMuted}" />

        <Setter
            Property="BackgroundColor"
            Value="{StaticResource InputBackground}" />

        <Setter
            Property="HeightRequest"
            Value="52" />

        <Setter
            Property="FontSize"
            Value="15" />

    </Style>


    <!-- ========================= -->
    <!-- TARJETAS -->
    <!-- ========================= -->

    <Style
        x:Key="CardBorder"
        TargetType="Border">

        <Setter
            Property="Background"
            Value="{StaticResource Surface}" />

        <Setter
            Property="Stroke"
            Value="{StaticResource BorderColor}" />

        <Setter
            Property="StrokeThickness"
            Value="1" />

        <Setter
            Property="StrokeShape">

            <RoundRectangle
                CornerRadius="12" />

        </Setter>

        <Setter
            Property="Padding"
            Value="16" />

    </Style>


    <!-- ========================= -->
    <!-- SECCIÓN -->
    <!-- ========================= -->

    <Style
        x:Key="SectionLabel"
        TargetType="Label">

        <Setter
            Property="TextColor"
            Value="{StaticResource TextSecondary}" />

        <Setter
            Property="FontSize"
            Value="14" />

        <Setter
            Property="FontAttributes"
            Value="Bold" />

    </Style>

</ResourceDictionary>